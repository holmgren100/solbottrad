# ============================================================================
# ML BOT 2 FOUNDATION - Clean Configuration
# ============================================================================
# Based on ML Bot 2's 71.7% win rate proven settings
# Only includes settings actually used by the current implementation
# ============================================================================

# ============================================================================
# TRADING MODE
# ============================================================================
PAPER_TRADING_MODE=true
PAPER_SOL_BALANCE=5.0

# ============================================================================
# POSITION SIZING (ML Bot 2 Settings)
# ============================================================================
DEFAULT_POSITION_SIZE=70
MAX_OPEN_POSITIONS=7

# ============================================================================
# ML BOT 2 CORE: TRAILING STOPS (PROVEN - DON'T CHANGE!)
# ============================================================================
# ML Bot 2 achieved 85-93% win rate on trailing stop exits!
USE_TRAILING_STOP=true
TRAILING_STOP_PERCENT=15.0
STOP_LOSS_PERCENT=20.0
TAKE_PROFIT_PERCENT=50.0

# ============================================================================
# ML BOT 2 CORE: PARTIAL PROFIT TAKING (CRITICAL!)
# ============================================================================
# This locks in profits before crashes - key to 71.7% win rate
PARTIAL_PROFIT_ENABLED=true
PROFIT_MILESTONE_100=25    # Sell 25% at +100% profit
PROFIT_MILESTONE_200=15    # Sell 15% at +200% profit
PROFIT_MILESTONE_300=10    # Sell 10% at +300% profit
PROFIT_MILESTONE_400=10    # Sell 10% at +400% profit
PROFIT_MILESTONE_500=10    # Sell 10% at +500% profit
PROFIT_MILESTONE_600=10    # Sell 10% at +600% profit
PROFIT_MILESTONE_700=10    # Sell 10% at +700% profit

# ============================================================================
# ML BOT 2 CORE: RUG DETECTION (PROVEN - DON'T CHANGE!)
# ============================================================================
# ML Bot 2 achieved 73.7% win on low liq exits - superior selection!
RUG_DETECTION_ENABLED=true
STALE_PRICE_MINUTES=5
MIN_POSITION_LIQUIDITY=5000.0

# ============================================================================
# SCANNING & MONITORING
# ============================================================================
SCAN_INTERVAL=120          # Seconds between token scans
MONITOR_INTERVAL=60        # Seconds between position monitoring

# ============================================================================
# ENHANCEMENT MODULES (OPTIONAL - TEST IMPACT!)
# ============================================================================

# --- CSV Tracking (Recommended: YES - Essential for analysis) ---
ENABLE_CSV_TRACKING=true
CSV_AUTO_EXPORT=true
CSV_EXPORT_PATH=data/ml_trades.csv

# --- Safety Filters (Recommended: TEST - May help or hurt) ---
ENABLE_SAFETY_FILTERS=false

# LP Lock Checking
ENABLE_LP_LOCK_CHECK=true
LP_LOCK_MIN_DAYS=30
LP_LOCK_ACCEPT_BURNED=true

# Holder Concentration
ENABLE_HOLDER_CHECK=true
HOLDER_TOP10_MAX=50.0
HOLDER_TOP1_MAX=20.0

# Contract Safety
ENABLE_CONTRACT_SAFETY=true
REJECT_MINT_AUTHORITY=true
REJECT_FREEZE_AUTHORITY=true
REQUIRE_OWNERSHIP_RENOUNCED=true

