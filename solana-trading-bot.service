[Unit]
Description=Solana Trading Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/solbottrad
EnvironmentFile=/root/solbottrad/.env
ExecStart=/usr/bin/python3 -m trading_bot.main
Restart=on-failure
RestartSec=10
StandardOutput=append:/root/solbottrad/bot.log
StandardError=append:/root/solbottrad/bot.log

[Install]
WantedBy=multi-user.target
