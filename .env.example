# Solana Trading Bot Configuration
# Copy this file to .env and fill in your actual values

# === API Keys ===

# Alchemy API Key (Required)
# Get from: https://www.alchemy.com/
ALCHEMY_API_KEY=your_alchemy_api_key_here

# SolSniffer API Key (Optional)
# Get from: https://solsniffer.com/
SOLSNIFFER_API_KEY=your_solsniffer_api_key_here

# DexScreener API Key (Optional)
# Free tier available
DEXSCREENER_API_KEY=your_dexscreener_api_key_here

# Twitter Bearer Token (Optional but recommended)
# Get from: https://developer.twitter.com/
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Telegram Bot Token (Required for notifications)
# Get from: @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Chat ID (Required for notifications)
# Get by messaging @userinfobot on Telegram
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# GMGN Telegram Bot (For trade execution)
GMGN_TELEGRAM_BOT=@gmgnsolbot

# === Trading Configuration ===

# Paper Trading Mode (true = simulated trading, false = live trading)
PAPER_TRADING_MODE=true

# Maximum position size in USD
MAX_POSITION_SIZE=100

# Minimum liquidity threshold in USD
MIN_LIQUIDITY_USD=10000

# Maximum slippage percentage
MAX_SLIPPAGE_PERCENT=5

# Minimum confidence score for trading (0-1)
MIN_CONFIDENCE_SCORE=0.7

# Priority fee in SOL for transactions
PRIORITY_FEE=0.001

# === Risk Management ===

# Maximum portfolio risk percentage
MAX_PORTFOLIO_RISK_PERCENT=10

# Stop loss percentage
STOP_LOSS_PERCENT=20

# Take profit percentage
TAKE_PROFIT_PERCENT=50

# Maximum number of trades per day
MAX_DAILY_TRADES=10

# Maximum number of open positions
MAX_OPEN_POSITIONS=5

# === Logging ===

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path
LOG_FILE=trading_bot.log
