# Solana Trading Bot Configuration
# Copy this file to .env and fill in your actual API keys

# ================================================================
# LIVE TRADING PHASE 0 CONFIGURATION ($1-4 positions, ultra-safe)
# ================================================================
# For Phase 0 live testing, use these settings:
# PAPER_TRADING_MODE=false
# DEFAULT_POSITION_SIZE=2.0
# MAX_POSITION_SIZE=4.0
# MAX_OPEN_POSITIONS=5
# SOLANA_PRIVATE_KEY=your_actual_wallet_key
# Capital needed: ~$100 SOL
# Duration: 1-2 hours, 5-10 trades
# ================================================================

# === Trading Configuration ===
PAPER_TRADING_MODE=true
PAPER_SOL_BALANCE=5.0
MAX_POSITION_SIZE=200
MIN_LIQUIDITY_USD=5000.0
MIN_LIQUIDITY=5000.0
MIN_VOLUME=1000
MAX_SLIPPAGE_PERCENT=5
DEFAULT_SLIPPAGE=5.0
# Confidence filtering: 0.4 filters out garbage tokens (Twitter failures, low sentiment)
# 0.0 = no filter (buys anything), 0.4 = moderate filter, 0.7 = strict filter
MIN_CONFIDENCE_SCORE=0.4
MIN_SENTIMENT_SCORE=0.5
MIN_SOCIAL_SCORE=0.6
PRICE_CHANGE_THRESHOLD=0.05
DEFAULT_POSITION_SIZE=60
DEFAULT_BUY_AMOUNT=0.01
DEFAULT_PRIORITY_FEE=0.0001
PRIORITY_FEE=0.001

# === Risk Management ===
# BATCH 9 OPTIMIZATION: Widened stop loss from 10% to 15%
# Analysis: 22% of trades hit stop loss with 0% win rate (-$452 loss)
# Wider stop gives trades more room to breathe, expected -30% stop hits
STOP_LOSS_PERCENT=15
STOP_LOSS_PERCENTAGE=0.15
TAKE_PROFIT_PERCENT=20
TAKE_PROFIT_PERCENTAGE=0.20
MAX_PORTFOLIO_RISK_PERCENT=10
MAX_DAILY_TRADES=10
MAX_OPEN_POSITIONS=7

# === Trailing Stop Loss (Recommended) ===
# Trailing stop follows the price up and locks in profits
# When enabled, fixed TAKE_PROFIT is ignored
USE_TRAILING_STOP=true
TRAILING_STOP_PERCENT=10
# Example: Buy at $1, price goes to $10 (900% up), trailing stop at $9.00 (10% below peak)
# Tighter 10% stop exits before rugs complete while still capturing big pumps!

# === Partial Profit Taking (Locks in gains at milestones) ===
# Automatically sells portions of position at profit milestones
# Example: +100% → sell 15%, +200% → sell 20%, etc.
# Prevents losing all profits if token crashes after pump
PARTIAL_PROFIT_ENABLED=true
PROFIT_MILESTONE_100=15   # Sell 15% at +100% profit
PROFIT_MILESTONE_200=20   # Sell 20% at +200% profit
PROFIT_MILESTONE_300=15   # Sell 15% at +300% profit
PROFIT_MILESTONE_400=10   # Sell 10% at +400% profit
PROFIT_MILESTONE_500=10   # Sell 10% at +500% profit
PROFIT_MILESTONE_600=10   # Sell 10% at +600% profit
PROFIT_MILESTONE_700=10   # Sell 10% at +700% profit
# Total: 90% sold across all milestones, keeps 10% runner for moonshots

# === Age-Based Profit Strategies (Phase 1) ===
# Different tokens behave differently based on age - strategies adapt automatically
# Bot selects strategy based on pair creation timestamp from DexScreener
#
# Strategy 1: NEW/FRESH TOKENS (0-6 hours old)
#   - Can moon fast or rug fast, aggressive profit-taking
#   - Milestones: 20% at +100%, 25% at +200%, 25% at +300%
#   - Trailing stop: 15% (wide for high volatility)
#   - Position size: 0.8x (smaller for higher risk)
#
# Strategy 2: ESTABLISHED TOKENS (6 hours - 3 days old)
#   - Balanced approach, uses default settings above
#   - Milestones: 15% at +100%, 20% at +200%, 15% at +300%
#   - Trailing stop: 15%
#   - Position size: 1.0x (normal)
#
# Strategy 3: MATURE TOKENS (3-7 days old)
#   - Conservative, take profits early
#   - Milestones: 30% at +50%, 30% at +100%, 20% at +150%
#   - Trailing stop: 8% (tighter)
#   - Position size: 1.2x (larger, safer)
#
# Strategy 4: STABLE TOKENS (7+ days old)
#   - Very conservative, quick exits
#   - Milestones: 40% at +50%, 30% at +100%, 20% at +150%
#   - Trailing stop: 5% (very tight)
#   - Position size: 1.5x (largest, safest)
#
# No configuration needed - strategies auto-select based on token age!

# === Rug Protection ===
# Auto-close positions when token appears rugged or dead
RUG_DETECTION_ENABLED=true
STALE_PRICE_MINUTES=3
MIN_POSITION_LIQUIDITY=8000.0
# If no price update in 3 minutes OR liquidity < $8000, position auto-closes
# Faster detection prevents bigger losses on rugs

# === BATCH 10 FIX: Liquidity Drop Monitoring ===
# Early exit when liquidity dropping rapidly (prevents 100% drop!)
# Analysis showed ALL 182 Batch 10 trades ended with 0 exit liquidity
ENABLE_LIQUIDITY_MONITORING=true
LIQUIDITY_DROP_THRESHOLD=50.0   # Exit if liquidity drops >50% from entry
# Example: Enter at $50k liquidity, exit at $25k (before it reaches $0)
# Prevents: Waiting until 100% drop and being forced to exit at terrible prices
# Impact: Better exit prices, avoid complete rug scenarios, +5-10% win rate expected

# === RugCheck API Integration (Phase 2) ===
# RugCheck performs early token security analysis before expensive API calls
# Blocks high-risk tokens with scam indicators (freeze authority, low score, etc.)
RUGCHECK_STRICT_MODE=true    # Enable/disable RugCheck filtering
RUGCHECK_MIN_SCORE=50        # Minimum RugCheck score (0-100, 50 = balanced)
# Scores: 0-30 = critical, 30-50 = high risk, 50-70 = medium, 70+ = low risk
# Strict mode blocks critical/high risk tokens immediately
# Set to false to disable RugCheck filtering (not recommended)

# === Multi-Layer Screening System (Phase 3) ===
# Advanced filters using volume analysis, whale tracking, and movement detection
# Provides multiple layers of protection and smart money signal detection
#
# Layer 1: Volume Breakout Detection (Smart Money Tracking)
ENABLE_VOLUME_BREAKOUT=true
# Detects unusual volume spikes (3x-10x+ average) indicating smart money accumulation
# Tracks volume trends, trading activity, and sustained high volume patterns
# Signals: normal, moderate_accumulation, strong_accumulation
# Helps identify tokens with real buying pressure vs pump & dumps
#
# Layer 2: Whale Concentration Analysis
ENABLE_WHALE_TRACKING=true
# Analyzes top token holders via Solscan API
# Detects concentration risk (top 10 holders > 50% = risky)
# Flags whale presence (holders with >5% supply)
# Blocks tokens with critical concentration (top holder >20%, top 10 >80%)
#
# Layer 3: Unusual Movement Detection
ENABLE_MOVEMENT_DETECTION=true
# Monitors blockchain for suspicious transfer patterns
# Detects: rapid transfers, coordinated wallets, mass exodus, whale dumping
# Blocks tokens showing critical rug pull signals (liquidity removal, wallet draining)
# Analyzes recent transfers for unusual activity
#
# Note: All three layers work together for maximum protection
# Solscan API key optional but recommended for higher rate limits

# === Multi-Source Monitoring System (Enhanced) ===
# Advanced cross-validation using multiple data sources with adaptive thresholds
# Provides robust liquidity monitoring and dynamic scoring - NO HARD SETTINGS!
#
# Enable Multi-Source Data Aggregator (Combines Jupiter + DexScreener + Birdeye)
ENABLE_MULTI_SOURCE_AGGREGATOR=false
# Cross-validates price/liquidity across 3 sources using median
# Smart rate limiting: DexScreener (280/min), Jupiter (500/min), Birdeye (100/min)
# Confidence scoring: high (2+ sources agree), medium (2+ disagree), low (1 source)
# 5-second cache to prevent redundant API calls
# Continuous position monitoring every 5-10 seconds
#
# Enable RugCheck Holder Analysis (Advanced holder tracking)
ENABLE_RUGCHECK_HOLDER_ANALYSIS=false
# Analyzes top 10 holders, dev wallets, mint/freeze authority
# Safety scoring 0-100 (checks concentration, authority, liquidity lock)
# Risk levels: critical/high/medium/low
# Auto-rejects critical risks (>70% holder concentration, mint authority)
# Position sizing based on holder risk
#
# Enable Market Monitor (BTC/ETH/SOL crash detection)
ENABLE_MARKET_MONITOR=false
# Tracks Bitcoin, Ethereum, Solana prices via CoinGecko
# Market states: normal/warning/crash
# Stops trading during market crashes (>10% drop in 1 hour)
# Position size multiplier based on SOL health (0.7x if dumping, 1.2x if pumping)
# Essential: SOL health directly impacts Solana token liquidity
#
# Enable Dynamic Token Scorer (Learns from trade history)
ENABLE_DYNAMIC_SCORER=false
# NO HARD SETTINGS - adapts thresholds from last 200 trades
# 100-point scoring: Liquidity (50), Confidence (15), Volume (15), RugCheck (20), Market (10)
# Uses 25th percentile of winners as adaptive minimum
# pump.fun specific handling (stricter filters, smaller positions)
# Automatic position sizing based on score + holder risk + market conditions
#
# Position Monitoring Settings (when multi-source enabled)
POSITION_MONITORING_INTERVAL=5    # Check positions every 5 seconds (fast!)
LIQUIDITY_DROP_WARNING=30         # Warn if liquidity drops >30%
LIQUIDITY_DROP_CRITICAL=50        # Force exit if liquidity drops >50%
ABSOLUTE_MIN_LIQUIDITY=30000      # Force exit if liquidity <$30k
#
# Token Source Enable Flags (Individual APIs)
ENABLE_JUPITER=true               # Jupiter API (proven, reliable, free)
ENABLE_DEXSCREENER=false          # DexScreener (best liquidity data)
ENABLE_BIRDEYE=false              # Birdeye (Solana-native, needs API key)
ENABLE_COINGECKO=false            # CoinGecko API (top gainers/losers, free tier 30 calls/min)
ENABLE_APIFY=false                # Apify DexScreener scraper (BEST for GAINERS, ~$50/mo)
#
# Note: Multi-source aggregator combines ALL enabled sources
# Recommended: Start with Jupiter only, then add DexScreener, then Birdeye
# Expected improvements: 73% low liquidity → 15-20%, Win rate 9.8% → 30-40%

# === Fee & Slippage Simulation (Paper Trading) ===
# Simulate realistic trading costs for accurate performance metrics
# Total round-trip cost: ~2.1% (0.3% + 0.5% + 0.3% + 1.0%)
SIMULATE_FEES=true
BUY_FEE_PERCENT=0.3        # Jupiter + network fees on entry (~0.3%)
SELL_FEE_PERCENT=0.3       # Jupiter + network fees on exit (~0.3%)
BUY_SLIPPAGE_PERCENT=0.5   # Price slippage on entry (~0.5%)
SELL_SLIPPAGE_PERCENT=1.0  # Price slippage on exit (~1.0%, worse than entry)
# These costs mean you need +2.1% profit just to break even!
# Paper trading without fees will show unrealistic performance

# === REALISTIC LIQUIDITY & VOLUME FILTERS ===
# Evolution: 974 trades across 4 batches validated these optimized parameters
# Results: Unsellable 29.4%→17.3%, Real ROI 18.1%→19.5%, Avg Loss -$16→-$11
# These filters balance opportunity with safety for live trading
# LIVE TRADING RECOMMENDATION: Use $50k+ minimum for Phase 0 to avoid stuck positions
MIN_ENTRY_LIQUIDITY=50000       # $50k minimum liquidity to enter (prevents stuck positions)
MIN_EXIT_LIQUIDITY=25000        # $25k minimum to exit (ensures sellability)
MIN_24H_VOLUME=25000            # $25k daily volume required (confirms token activity)
MAX_POSITION_VS_LIQUIDITY=0.005 # Max 0.5% of liquidity pool (prevents high price impact)
# Example: $50k liquidity → max position size = $250 (0.5%)
# Higher liquidity filters reduce stuck position risk significantly!

# === TIER 2 FILTERS (Prevents 80% of High-Risk Trades!) ===
# Based on 200-trade risk analysis showing clear predictors of unsellable tokens
# These filters are CRITICAL for safe volume fallback strategy!
MIN_ENTRY_PRICE=0.10            # Minimum entry price (blocks ultra-cheap scam tokens)
                                # Tokens <$0.0001 are 6x more likely to be unsellable!
MAX_TOKENS_PER_DOLLAR=10000     # Maximum tokens per dollar (blocks high-volume scams)
                                # Problematic trades: 24,422 tokens/$ vs Safe trades: 3,034 tokens/$
                                # High volume trades (>10k tokens/$) have 80% risk rate!
MAX_POSITION_SIZE=50            # Hard cap on position size (prevents excessive slippage)
                                # Larger positions cause worse execution and higher risk
# Impact: Risk rate 23.5% → 10-12% (-50% reduction!), Real ROI 19.5% → 21-23% (+15% improvement!)
# Trade volume: -40% (but MUCH better quality - only safe tokens pass)

# === BATCH 9 OPTIMIZATIONS (Expected +30% Win Rate!) ===
# Based on 384-trade analysis of Batch 9 performance (26.8% win rate)
# These 4 new filters target the biggest performance gaps
#
# FIX #1: Activity Filter (CRITICAL - Expected +12-15% win rate!)
MIN_TOTAL_TRANSACTIONS=1000     # Minimum total txns (buys+sells) in last hour
                                # Analysis: 32% of trades had <500 txns with only 19.5% win rate
                                # Tokens with 2k-10k txns had 35.9% win rate (best range!)
                                # Impact: Skip 204 low-activity trades, focus on proven tokens
#
# FIX #2: Buy/Sell Ratio Filter (Expected +3-5% win rate)
MIN_BUY_SELL_RATIO=0.8          # Minimum buy/sell ratio (blocks dumping tokens)
                                # Analysis: Tokens with <0.8 ratio had only 14.7% win rate
                                # Tokens with 1.5+ ratio had 32.2% win rate
                                # Impact: Skip 46 dumping tokens, focus on buying pressure
#
# FIX #3: Stricter Price Limit (Expected +3-5% win rate)
MAX_ENTRY_PRICE=0.01            # Maximum entry price (stricter than old $10 limit!)
                                # Analysis: Losers averaged $0.0497 vs winners $0.0018 (28x higher!)
                                # Tokens >$0.01 had poor performance
                                # Impact: Skip 43 high-price trades, focus on low-price gems
#
# FIX #4: Golden Liquidity Range (Expected +5-8% win rate)
GOLDEN_LIQUIDITY_MIN=30000      # Golden liquidity range minimum ($30k)
GOLDEN_LIQUIDITY_MAX=50000      # Golden liquidity range maximum ($50k)
                                # Analysis: $30-50k liquidity had 43.3% win rate (best range!)
                                # Winners averaged $130k liq, losers $197k (lower is better!)
                                # Impact: Prioritize tokens in proven golden range
#
# COMBINED IMPACT:
# - Current: 384 trades, 26.8% win rate, -2.05% ROI
# - After fixes: ~150 trades, 50-58% win rate, +15-25% ROI
# - Timeline: 3 days to profitable! 🚀

# === VOLUME FALLBACK (PROTECTED by Tier 2 Filters!) ===
# Sometimes DexScreener/Jupiter can't fetch liquidity but volume exists
# High volume usually means there IS liquidity, we just can't see it
# IMPORTANT: Volume fallback now PROTECTED - also checks MIN_ENTRY_PRICE and MAX_TOKENS_PER_DOLLAR!
# This prevents volume fallback from catching ultra-cheap scam tokens with huge quantities
ALLOW_VOLUME_FALLBACK=true
MIN_VOLUME_FOR_FALLBACK=50000        # $50k volume = assume liquidity exists
VOLUME_FALLBACK_POSITION_MULTIPLIER=0.5  # Use 50% of normal position size (safer!)
# Example: Normal position $60 → Volume fallback $30 (reduced risk)
# Protection: Only allows fallback if price >$0.10 AND tokens/$ <10,000
# Result: Volume fallback catches REAL high-volume opportunities, not scam tokens!

# === Stuck Position Management (CRITICAL for Live Trading!) ===
# Prevents positions from blocking slots when tokens become illiquid or rugged
# Better to accept a small loss than miss profitable opportunities
AUTO_CLEANUP_ENABLED=true              # Automatically cleanup stuck positions
MAX_POSITION_AGE_HOURS=48              # Force close positions older than 48 hours
STUCK_LIQUIDITY_THRESHOLD=1000         # Position is stuck if liquidity < $1k
STUCK_TIME_HOURS=6                     # Position stuck if low liquidity for >6 hours
FORCE_CLOSE_ON_RUG=true                # Auto-close rugged positions (zero exit liquidity)
# How it works:
# 1. Enhanced rug detection force-closes positions with insufficient exit liquidity
# 2. Old positions (>48h) auto-cleanup to free slots
# 3. Stuck positions (low liquidity >6h) detected and cleaned
# 4. Manual cleanup via /cleanup Telegram command
# Impact: Ensures position slots stay available for profitable trades!

# === Trading Execution ===
MAX_TRADE_RETRIES=3
TRADE_TIMEOUT=30

# === Monitoring ===
HEALTH_CHECK_INTERVAL=300
RATE_LIMIT_CALLS=30
RATE_LIMIT_PERIOD=60
MAX_RETRIES=3
RETRY_DELAY=5
MONITORING_INTERVAL=60

# === Enhanced Monitoring System (Phase 0) ===
# Tracks APIs, strategies, and triggers with automatic Telegram alerts
# Monitors: Alchemy, Jupiter, DexScreener, Twitter, SolSniffer, RugCheck
ALERT_API_DOWN_MINUTES=5          # Alert if API success rate < 90% (cooldown: 5min)
ALERT_ERROR_RATE_PER_HOUR=10      # Alert if >10 errors/hour
ALERT_NO_TOKENS_MINUTES=30        # Alert if strategy finds 0 tokens for 30min
ALERT_COOLDOWN_MINUTES=15         # Default cooldown between duplicate alerts

# === Data Storage ===
TRADE_JOURNAL_PATH=data/trade_journal.csv

# === API Keys - Blockchain ===
# Get Alchemy API key from: https://www.alchemy.com/
ALCHEMY_API_KEY=your_alchemy_api_key_here
ALCHEMY_WSS=wss://solana-mainnet.g.alchemy.com/v2/your_alchemy_api_key_here
# Get SolSniffer API key from: https://solsniffer.com/
SOLSNIFFER_API_KEY=your_solsniffer_api_key_here
# Get Solscan API key from: https://solscan.io/ (for whale tracking & movement detection)
SOLSCAN_API_KEY=your_solscan_api_key_here

# === API Keys - Market Data ===
# Get Birdeye API key from: https://birdeye.so/ (PRIMARY - Solana-native trending + new tokens)
BIRDEYE_API_KEY=your_birdeye_api_key_here
# Get CoinGecko API key from: https://www.coingecko.com/en/api (FREE - Top gainers/losers)
COINGECKO_API_KEY=your_coingecko_api_key_here
# Get Apify API token from: https://console.apify.com/account/integrations (~$50/mo - DexScreener scraper)
APIFY_API_TOKEN=your_apify_api_token_here
DEXSCREENER_API_KEY=
DEXSCREENER_API_URL=https://api.dexscreener.com/token-profiles/latest/v1
METEORA_API_KEY=your_actual_key_here
RUGCHECK_API_KEY=your_actual_key_here
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here
CRYPTORANK_API_KEY=your_cryptorank_api_key_here
BITQUERY_API_KEY=your_bitquery_api_key_here
SANTIMENT_API_KEY=your_santiment_api_key_here

# === API Keys - Social Media ===
# Get Twitter bearer token from: https://developer.twitter.com/
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here
TELEGRAM_SESSION_NEW=your_telegram_session_string_here

# === API Keys - AI ===
# Get OpenAI key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# === Telegram Bot (for notifications and control) ===
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Get chat ID from @userinfobot on Telegram
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# === Trading Execution ===
GMGN_TELEGRAM_BOT=@GMGN_sol_bot
GMGN_BOT_USERNAME=@GMGN_sol_bot

# === Smart Money Tracking ===
TRACKED_WALLETS=3jbU2sKhQAY34pT7o8ZwtfNnRCcke2L63ZFQJhC83EDm,CdFHmaj37EtjgRqvyt6vZqoA9tuMSvKLSmbgpuV6ejaP,EB1jfLdgzHYWVhD7ogNDixUaXLUipUZUbSHm4KTviNeL

# === Logging ===
LOG_LEVEL=INFO
LOG_FILE=trading_bot.log
