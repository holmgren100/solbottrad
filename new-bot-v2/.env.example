# Fearless Momentum Runner v2.0 - Environment Variables

# ==============================================================================
# ALCHEMY API (FREE TIER)
# ==============================================================================
# Get your FREE API key at: https://www.alchemy.com/
# Free tier: 300M compute units/month (plenty for our needs!)
ALCHEMY_API_KEY=your_alchemy_api_key_here

# ==============================================================================
# BIRDEYE API (FREE TIER)
# ==============================================================================
# Get your FREE API key at: https://birdeye.so
# Free tier: 100 requests/min
# Used for: Token discovery (trending), prices, OHLCV, security checks
BIRDEYE_API_KEY=your_birdeye_api_key_here

# ==============================================================================
# SOLSCAN API (FREE TIER)
# ==============================================================================
# Get your API key at: https://solscan.io/
# Free tier: Generous limits
# Used for: Token metadata, holder analysis
SOLSCAN_API_KEY=your_solscan_api_key_here

# ==============================================================================
# SOLSNIFFER API
# ==============================================================================
# Get your API key at: https://solsniffer.com/
# Used for: Token security checks, rug detection
SOLSNIFFER_API_KEY=your_solsniffer_api_key_here

# ==============================================================================
# DEXSCREENER API (FREE - NO KEY NEEDED)
# ==============================================================================
# DexScreener API is free and requires no API key!
# Used for: Market data, price candles, buy/sell pressure, token discovery
# Note: Be respectful of rate limits (we use 2-sec delays)

# ==============================================================================
# SOLANA WALLET (OPTIONAL - FOR LIVE TRADING)
# ==============================================================================
# Only needed if you want to execute actual swaps
# For paper trading / backtesting, leave empty
SOLANA_WALLET_PRIVATE_KEY=

# ==============================================================================
# TELEGRAM NOTIFICATIONS (OPTIONAL)
# ==============================================================================
# Get bot token from @BotFather on Telegram
# Get chat ID from @userinfobot on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==============================================================================
# CONFIGURATION
# ==============================================================================
# Environment: development, production
ENVIRONMENT=development

# Enable/disable live trading (vs paper trading)
LIVE_TRADING=false

# ==============================================================================
# NOTES
# ==============================================================================
# COST: $0/month - All APIs are FREE!
# - Alchemy: FREE tier (300M compute units/month)
# - Jupiter: FREE (unlimited)
# - DexScreener: FREE (rate limited)
#
# SAFETY:
# - Never commit your .env file to git!
# - Keep your API keys secret
# - For production, use environment variables or secrets manager
