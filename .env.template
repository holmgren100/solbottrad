PROFIT_MILESTONE_100=15         # Sell 15% at +100%
PROFIT_MILESTONE_200=20         # Sell 20% at +200%
PROFIT_MILESTONE_300=15         # Sell 15% at +300%
PROFIT_MILESTONE_400=10         # Sell 10% at +400%
PROFIT_MILESTONE_500=10         # Sell 10% at +500%
PROFIT_MILESTONE_600=10         # Sell 10% at +600%
PROFIT_MILESTONE_700=10         # Sell 10% at +700%
# Remaining 10% continues with trailing stop

# ========================================
# 🛡️ RUG PROTECTION (Nov 30 Working Settings)
# ========================================
RUG_DETECTION_ENABLED=true
STALE_PRICE_MINUTES=2           # Auto-close if no price movement in 2 min
FROZEN_PRICE_MINUTES=15         # Honeypot detection timeout
MIN_POSITION_LIQUIDITY=5000.0   # $5k minimum liquidity or auto-close
FORCE_CLOSE_ON_RUG=true         # Force close on rug signals

# ========================================
# 💧 LIQUIDITY & VOLUME FILTERS (Nov 30 Working Settings)
# ========================================
MIN_ENTRY_LIQUIDITY=30000       # $30k minimum to enter (golden baseline)
MIN_EXIT_LIQUIDITY=15000        # $15k minimum to exit
MIN_24H_VOLUME=15000            # $15k daily volume required
MAX_POSITION_VS_LIQUIDITY=0.005 # Max 0.5% of liquidity pool

# Price filters (block scam tokens)
MIN_ENTRY_PRICE=0.10            # $0.10 minimum entry price
MAX_TOKENS_PER_DOLLAR=10000     # Max 10k tokens per dollar

# === VOLUME FALLBACK (when liquidity data unavailable) ===
ALLOW_VOLUME_FALLBACK=true
MIN_VOLUME_FOR_FALLBACK=50000   # $50k volume = assume liquidity exists
VOLUME_FALLBACK_POSITION_MULTIPLIER=0.5  # Use 50% position (safer!)

# ========================================
# 🧹 STUCK POSITION CLEANUP (Nov 30 Working Settings)
# ========================================
AUTO_CLEANUP_ENABLED=true
MAX_POSITION_AGE_HOURS=48       # Close positions older than 48h
STUCK_LIQUIDITY_THRESHOLD=1000  # $1k liquidity = stuck
STUCK_TIME_HOURS=6              # Close if stuck for 6+ hours

# ========================================
# 🎚️ CONFIDENCE & SENTIMENT FILTERS (Nov 30 Working Settings)
