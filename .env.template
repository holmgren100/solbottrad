MAX_OPEN_POSITIONS=5            # Max concurrent positions

# ========================================
# 🎯 PROFIT STRATEGY (Nov 30 Working Settings)
# ========================================
# Trailing Stop (recommended - follows price up, locks profits)
USE_TRAILING_STOP=true          # Recommended: exits before rugs, captures pumps
TRAILING_STOP_PERCENT=10        # 10% below peak (golden baseline)

# Fixed Take Profit (ignored if trailing stop enabled)
TAKE_PROFIT_PERCENT=20          # 20% profit target
STOP_LOSS_PERCENT=7             # 7% stop loss

# === PARTIAL PROFIT TAKING (lock profits at milestones) ===
