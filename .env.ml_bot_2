# ===================================================================
# ML BOT 2 FOUNDATION - TRADING CONFIGURATION
# ===================================================================
# Based on ML Bot 2 (71.7% win rate, 9.02x profit factor)
#
# Copy this to .env to use:
#   cp .env.ml_bot_2 .env
#
# Quick Start Checklist:
# 1. ✅ Copy this file to .env
# 2. ✅ Set PAPER_TRADING_MODE=true (test first!)
# 3. ✅ Add your API keys below
# 4. ✅ Choose enhancement options
# 5. ✅ Run: python trading_bot/main.py
# ===================================================================

# ===================================================================
# 🎯 MODE SELECTION
# ===================================================================
PAPER_TRADING_MODE=true
PAPER_SOL_BALANCE=1000.0

# ===================================================================
# 🔒 ML BOT 2 PROTECTED CORE SETTINGS
# ===================================================================
# These achieved 71.7% win rate - DO NOT modify without data proof!

# --- Trailing Stops (85-93% win rate on trail exits!) ---
USE_TRAILING_STOP=true
TRAILING_STOP_PERCENT=15.0          # 15% below PEAK price

# --- Position Management ---
MAX_OPEN_POSITIONS=7
STOP_LOSS_PERCENT=20.0              # Fallback if trailing disabled
TAKE_PROFIT_PERCENT=50.0            # Fallback if trailing disabled

# --- Rug Detection ---
RUG_DETECTION_ENABLED=true
STALE_PRICE_MINUTES=5               # No update = rug
MIN_POSITION_LIQUIDITY=5000         # Below this = rug

# --- Monitoring ---
SCAN_INTERVAL=120                   # Scan every 2 min
MONITOR_INTERVAL=60                 # Monitor every 1 min

# ===================================================================
# ✅ ENHANCEMENT MODULES (Optional - Can toggle on/off)
# ===================================================================

# CSV Tracking (RECOMMENDED - Essential for analysis!)
ENABLE_CSV_TRACKING=true
CSV_AUTO_EXPORT=true

# Safety Filters (TEST FIRST - may help or hurt!)
# ⚠️  ML Bot 2 wins WITHOUT these! A/B test to prove impact.
ENABLE_SAFETY_FILTERS=false

# If safety filters enabled:
ENABLE_LP_LOCK_CHECK=true
LP_LOCK_MIN_DAYS=30
ENABLE_HOLDER_CHECK=true
HOLDER_TOP10_MAX=50.0
HOLDER_TOP1_MAX=20.0
ENABLE_CONTRACT_SAFETY=true

# ===================================================================
# 🔑 API KEYS (Add your keys here)
# ===================================================================

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_PRIVATE_KEY=

# DexScreener
DEXSCREENER_API_KEY=

# Jupiter
JUPITER_API_URL=https://quote-api.jup.ag/v6

# SolSniffer (security analysis)
SOLSNIFFER_API_KEY=

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===================================================================
# 📊 LOGGING
# ===================================================================
LOG_LEVEL=INFO
LOG_FILE=trading_bot.log

# ===================================================================
# 🧪 A/B TESTING GUIDE
# ===================================================================
#
# Test 1: Baseline (Core Only)
#   ENABLE_CSV_TRACKING=true
#   ENABLE_SAFETY_FILTERS=false
#   Goal: 65-75% win rate (baseline)
#
# Test 2: Core + Safety
#   ENABLE_SAFETY_FILTERS=true
#   Goal: Does it improve or hurt win rate?
#
# Compare CSV exports to decide!
# ===================================================================
